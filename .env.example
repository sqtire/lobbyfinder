# ---- shared ----
REDIS_URL=              # Railway: reference ${{Redis.REDIS_URL}} on BOTH services
KEY_PREFIX=mpf          # optional; MUST match between worker and web
OSU_CLIENT_ID=          # osu! OAuth application (https://osu.ppy.sh/home/account/edit#oauth)
OSU_CLIENT_SECRET=      # same app on BOTH services: worker uses client_credentials, web uses the auth-code login

# ---- worker service ----
# INDEX_RETENTION_DAYS=90   # how far back tenant backfills can reach (~1 MB/day of Redis)
# ROLL_DELAY_SEC=14400      # process a lobby once it is this old (closed by then)

# ---- web service ----
SESSION_SECRET=         # random; generate with: openssl rand -hex 32
OWNER_OSU_IDS=          # comma-separated osu! user ids that get the owner panel (API walks, global switch), e.g. 36887266
PUBLIC_BASE_URL=        # e.g. https://lobbyfinder.up.railway.app — used to build the OAuth callback URL
                        # osu! app "Application Callback URL" must be exactly: ${PUBLIC_BASE_URL}/api/auth/callback
# MAX_TOURNAMENTS_PER_USER=5
